---
import PageLayout from '@/layouts/Base.astro'
import { siteConfig } from '@/site.config'
---

<PageLayout meta={{ title: 'About' }}>
  <div class="max-w-2xl space-y-4 py-2 leading-relaxed">
    <h1 class="font-sans text-3xl font-black tracking-tight text-accent-2">
      {siteConfig.author}
    </h1>
    <p>
      I'm a software engineer at Walmart. This site is where I write about
      technology, design, and the occasional thought that crosses my mind.
    </p>
    <p>
      I care about building things that are simple, fast, and put together with
      intention — the code as much as the way it's presented. Basically, I still
      believe in <code>import this</code>.
    </p>
  </div>
</PageLayout>
