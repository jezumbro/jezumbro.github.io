---
import BaseHead from '@/components/BaseHead.astro'
import SkipLink from '@/components/SkipLink.astro'
import Footer from '@/components/layout/Footer.astro'
import Sidebar from '@/components/layout/Sidebar.astro'
import { siteConfig } from '@/site.config'
import type { SiteMeta } from '@/types'
import PostHog from '@/components/posthog.astro'

interface Props {
  meta: SiteMeta
}

const {
  meta: { articleDate, description = siteConfig.description, ogImage, title },
} = Astro.props
---

<html class="scroll-smooth" lang={siteConfig.lang}>
  <head>
    <PostHog />
    <BaseHead
      articleDate={articleDate}
      description={description}
      ogImage={ogImage}
      title={title}
    />
  </head>
  <body
    class="mx-auto flex min-h-screen max-w-5xl flex-col bg-bgColor px-4 py-8 font-serif text-textColor antialiased sm:px-8 sm:py-16 md:mx-auto md:flex-row md:gap-x-10"
  >
    <SkipLink />
    <Sidebar />
    <main id="main" class="flex flex-1 flex-col">
      <slot />
      <Footer />
    </main>
  </body>
</html>
